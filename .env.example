# Copy to .env and fill in. Never commit .env.

# --- Discord (Developer Portal → your application) ---------------------------------------------
# Bot → Reset Token. Required.
DISCORD_TOKEN=

# --- AI service -----------------------------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
# Host port docker compose publishes the AI service on. If 8000 is already used (e.g. by a local
# Supabase stack), pick another port and update AI_SERVICE_URL to match.
AI_SERVICE_PORT=8000

# --- Behaviour ------------------------------------------------------------------------------------
# While true, RageGuard only LOGS the timeouts it would apply. Set to false to enforce.
MONITOR_ONLY=true
# trace | debug | info | warn | error  (RUST_LOG overrides this if set)
LOG_LEVEL=info

# Optional: path to the detection config file (default: rageguard.toml).
# RAGEGUARD_CONFIG=rageguard.toml
# Optional: where the channel chosen in Discord is saved (default: data).
# RAGEGUARD_DATA_DIR=data
