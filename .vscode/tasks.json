{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build",
            "type": "shell",
            "command": "cargo build",
            "options": { "cwd": "${workspaceFolder}/bot" },
            "problemMatcher": ["$rustc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "cargo run (bot)",
            "type": "shell",
            "command": "cargo run",
            "options": { "cwd": "${workspaceFolder}/bot" },
            "problemMatcher": ["$rustc"],
            "isBackground": false
        },
        {
            "label": "cargo test",
            "type": "shell",
            "command": "cargo test",
            "options": { "cwd": "${workspaceFolder}/bot" },
            "problemMatcher": ["$rustc"],
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "cargo test (live AI service)",
            "type": "shell",
            "command": "cargo test --test e2e_ai_service -- --ignored --nocapture",
            "options": { "cwd": "${workspaceFolder}/bot" },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo clippy",
            "type": "shell",
            "command": "cargo clippy --all-targets -- -D warnings",
            "options": { "cwd": "${workspaceFolder}/bot" },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo fmt",
            "type": "shell",
            "command": "cargo fmt",
            "options": { "cwd": "${workspaceFolder}/bot" },
            "problemMatcher": []
        },
        {
            "label": "AI service: run locally",
            "type": "shell",
            "command": ".venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
            "windows": {
                "command": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000"
            },
            "options": { "cwd": "${workspaceFolder}/ai-service" },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "AI service: pytest",
            "type": "shell",
            "command": ".venv/bin/python -m pytest",
            "windows": { "command": ".venv\\Scripts\\python.exe -m pytest" },
            "options": { "cwd": "${workspaceFolder}/ai-service" },
            "problemMatcher": []
        },
        {
            "label": "docker compose up (AI service)",
            "type": "shell",
            "command": "docker compose up -d --build",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "docker compose up (bot + AI service)",
            "detail": "Runs the bot in Docker (reads .env). Use this when host builds are blocked, e.g. by Smart App Control.",
            "type": "shell",
            "command": "docker compose --profile bot up -d --build",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "docker compose logs (bot)",
            "type": "shell",
            "command": "docker compose logs -f --tail 100 bot",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "docker compose stop (bot)",
            "type": "shell",
            "command": "docker compose --profile bot stop bot",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
